    "/bad-exa": {
      "type": "application/json",
      "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"changed upstream format\"}]}}"
    },
    "/missing": {
      "type": "application/json",
      "body": "{}"
    },
    "/bad-url": {
      "type": "application/json",
      "body": "{\"results\": [{\"title\": \"Bad\", \"url\": \"file:///etc/passwd\", \"content\": \"bad\"}]}"
    },
    "/credentials": {
      "type": "application/json",
      "body": "{\"results\": [{\"title\": \"Bad\", \"url\": \"https://user:secret@example.com\", \"content\": \"bad\"}]}"
