{
  "routes": {
    "/ollama": {
      "type": "application/json",
      "body": "{\"results\": [{\"title\": \"Shipping guide\", \"url\": \"https://example.com/guide\", \"content\": \"Shipping is free at 50. café\"}, {\"title\": \"API\", \"url\": \"https://example.com/api\", \"content\": \"Reference\"}]}"
    },
    "/exa": {
      "type": "application/json",
      "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"Title: Shipping guide\\nURL: https://example.com/guide\\nPublished: N/A\\nAuthor: N/A\\nHighlights:\\nShipping is free at 50. café\\n\\n---\\n\\nTitle: API\\nURL: https://example.com/api\\nText: Reference\"}]}}"
    },
    "/sse": {
      "type": "text/event-stream",
      "body": ": ping\r\nevent: message\r\ndata: {\"jsonrpc\": \"2.0\", \"method\": \"notifications/progress\"}\r\n\r\ndata: {\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"Title: Shipping guide\\nURL: https://example.com/guide\\nPublished: N/A\\nAuthor: N/A\\nHighlights:\\nShipping is free at 50. café\\n\\n---\\n\\nTitle: API\\nURL: https://example.com/api\\nText: Reference\"}]}}\r\n\r\n"
    },
    "/empty": {
      "type": "application/json",
      "body": "{\"results\": []}"
    },
    "/exa-empty": {
      "type": "application/json",
      "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"No search results found. Please try a different query.\"}]}}"
    },
    "/note": {
      "type": "application/json",
      "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"Note: Constraints relaxed\\n\\nTitle: Shipping guide\\nURL: https://example.com/guide\\nPublished: N/A\\nAuthor: N/A\\nHighlights:\\nShipping is free at 50. café\\n\\n---\\n\\nTitle: API\\nURL: https://example.com/api\\nText: Reference\"}]}}"
    },
    "/tool-error": {
      "type": "application/json",
      "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"result\": {\"content\": [{\"type\": \"text\", \"text\": \"private diagnostic\"}], \"isError\": true}}"
    },
    "/rpc-error": {
      "type": "application/json",
