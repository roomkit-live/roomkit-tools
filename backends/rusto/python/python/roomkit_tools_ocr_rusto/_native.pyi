from collections.abc import Awaitable

def _activity() -> int: ...
def _after_fork_in_child() -> None: ...
def _shutdown() -> int: ...

class Cancellation:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...

class Engine:
    def __init__(self, config_json: str) -> None: ...
    def bind(self, root: str, limits_json: str, cancel: Cancellation) -> Awaitable[Tool]: ...

class Tool:
    def call(self, arguments_json: str, cancel: Cancellation) -> Awaitable[str]: ...
