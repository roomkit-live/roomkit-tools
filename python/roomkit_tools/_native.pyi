from collections.abc import Awaitable

def _shutdown() -> int: ...

class ToolError(Exception): ...
class InvalidInputError(ToolError): ...
class AccessRefusedError(ToolError): ...
class LimitExceededError(ToolError): ...
class UnsupportedResourceError(ToolError): ...
class ToolIOError(ToolError): ...

class _Cancellation:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...

class _ShellTool:
    @staticmethod
    def create(root: str, options_json: str, cancellation: _Cancellation, outputs: _OutputStore | None = None) -> Awaitable[_ShellTool]: ...
    @staticmethod
    def definition_json() -> str: ...
    def call(self, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...

class _Workspace:
    def __init__(self, root: str) -> None: ...

class _ProcessSession:
    def __init__(self, root: str, options_json: str, outputs: _OutputStore | None = None) -> None: ...
    def is_closed(self) -> bool: ...
    def initialize(self, cancellation: _Cancellation) -> Awaitable[None]: ...
    @staticmethod
    def definition_json(name: str) -> str: ...
    def call(self, name: str, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...
    def close(self) -> Awaitable[bool]: ...

class _OutputStore:
    def __init__(self, parent: str, options_json: str) -> None: ...
    def is_closed(self) -> bool: ...
    @staticmethod
    def definition_json(name: str) -> str: ...
    def call(self, name: str, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...
    def close(self) -> Awaitable[bool]: ...

