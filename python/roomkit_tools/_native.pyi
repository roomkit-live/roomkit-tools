from collections.abc import Awaitable

class ToolError(Exception): ...
class InvalidInputError(ToolError): ...
class AccessRefusedError(ToolError): ...
class LimitExceededError(ToolError): ...
class UnsupportedResourceError(ToolError): ...
class ToolIOError(ToolError): ...

class _Cancellation:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...

class _ReadTool:
    @staticmethod
    def create(root: str, options_json: str, cancellation: _Cancellation) -> Awaitable[_ReadTool]: ...
    @staticmethod
    def definition_json() -> str: ...
    def read(self, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...

class _ListTool:
    @staticmethod
    def create(root: str, options_json: str, cancellation: _Cancellation) -> Awaitable[_ListTool]: ...
    @staticmethod
    def definition_json() -> str: ...
    def call(self, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...


class _GlobTool:
    @staticmethod
    def create(root: str, options_json: str, cancellation: _Cancellation) -> Awaitable[_GlobTool]: ...
    @staticmethod
    def definition_json() -> str: ...
    def call(self, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...


class _GrepTool:
    @staticmethod
    def create(root: str, options_json: str, cancellation: _Cancellation) -> Awaitable[_GrepTool]: ...
    @staticmethod
    def definition_json() -> str: ...
    def call(self, arguments_json: str, cancellation: _Cancellation) -> Awaitable[str]: ...
