    def ends(self) -> _JobEnds: ...
    def initialize(self, cancellation: _Cancellation) -> Awaitable[None]: ...
    @staticmethod
    def definition_json(name: str) -> str: ...
    def call(
        self, name: str, arguments_json: str, cancellation: _Cancellation, owner: str | None = None
    ) -> Awaitable[str]: ...
    def close_owner(self, owner: str | None) -> Awaitable[bool]: ...
    def close(self) -> Awaitable[bool]: ...
    def detach(self) -> Awaitable[bool]: ...

